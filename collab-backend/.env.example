# ── Collab Dashboard — backend ────────────────────────────────────────────────
# Copy to .env for local overrides. Every value below is optional: the defaults
# run the server correctly on a development machine with no .env at all.

# Port to listen on. Most hosts inject this themselves — do not hardcode it there.
PORT=3001

# Interface to bind. Defaults to 0.0.0.0, which is what container platforms need:
# a process bound only to loopback is unreachable from outside the container and
# its health check fails with no useful error.
HOST=0.0.0.0

# Comma-separated list of allowed browser origins. This was a hardcoded array of
# localhost URLs, which blocked every deployed frontend outright.
# Use * for a genuinely public deployment.
#   CORS_ORIGIN=https://collab.example.com,https://www.collab.example.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Where SQLite keeps documents AND session membership. On a host with ephemeral
# disk this MUST point at a mounted volume, or the database is wiped on every
# deploy and "persistence" becomes a claim rather than a feature.
#   DATABASE_PATH=/data/collab.sqlite
DATABASE_PATH=./data/collab.sqlite
