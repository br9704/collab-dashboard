# ── Collab Dashboard — frontend ───────────────────────────────────────────────
# Copy to .env.local for local overrides.
#
# IMPORTANT: Vite inlines VITE_* variables at BUILD time, not at runtime. An image
# built with the wrong value cannot be fixed by changing the environment and
# restarting — it has to be rebuilt. Set these before `npm run build`.

# Where the backend lives. One variable is normally all you need: the Yjs
# document URL is derived from it, including the ws:// -> wss:// upgrade that an
# https page requires (a browser blocks ws:// from https as mixed content).
#   VITE_SOCKET_URL=https://collab-backend.fly.dev
VITE_SOCKET_URL=http://localhost:3001

# Escape hatch for a split deployment where the document server is not on the
# same host as socket.io. Leave unset otherwise.
# VITE_COLLAB_URL=wss://collab-doc.example.com/collaboration
